{
  "expo": {
    "name": "Bushou",
    "slug": "bushou",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./bushou.png",
    "assetBundlePatterns": [
      "./app/assets/img/*"
    ],
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.surfzilla.bushou",
      "versionCode": 21,
      "permissions": [
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./bushou.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "b9ef7e0a-db38-45bd-81e4-ce4cfe6ee72f"
      }
    }
  }
}
